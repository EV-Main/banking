# Copy to `.env` and adjust. Loaded by dotenvy in development.
# Topology (ports, addresses, connection URLs) DEFAULTS from flake.nix (the
# `ports` attrset is the single source of truth); anything set here or in the
# environment wins. Normally this file holds secrets and per-machine overrides.
RUST_LOG=info,piggybank_core=debug,evbanking_auth=debug

# ── Cross-plane bridge consumer (identity → money) ────────────────────────────
# This hub PULLS concierge's user_outbox (UserEvents.PullUserLifecycle) to freeze /
# gate money ops on suspended/revoked users. The shared bearer token MUST match the
# value on the concierge side (dev default: dev-bridge-token).
BRIDGE_SERVICE_TOKEN=
# Seconds between bridge polls (default 5).
BRIDGE_POLL_SECS=5
# Client TLS for the concierge seam, used when CONCIERGE_BRIDGE_ADDR is `https://`.
# Pin concierge's CA here (a cluster-internal CA is not in the public roots); unset falls
# back to the public roots outside production. The file must be PEM CERTIFICATE blocks and
# nothing else: a path that cannot be read, a file with no certificate in it (a private
# key, DER bytes), or a key block sitting beside the certificate all fail the boot, rather
# than leaving the seam on an empty trust store. The server's certificate must carry the
# host of CONCIERGE_BRIDGE_ADDR (`concierge` in the cluster). The shared token proves this
# hub TO concierge and says nothing about who answered — TLS is the only reverse proof
# there is (EV-invest/banking#199).
# In production the hub REFUSES to boot when CONCIERGE_BRIDGE_ADDR is cleartext to anything
# but loopback, or is https:// with no CA pinned here (#199 phase 2). Development dials
# loopback in cleartext and is not held to either.
# BRIDGE_TLS_CA_PEM_FILE=
# The hub's client identity for mTLS, presented when concierge's listener asks for a
# client certificate — both files or neither; one without the other fails the boot.
# BRIDGE_TLS_CLIENT_CERT_PEM_FILE=
# BRIDGE_TLS_CLIENT_KEY_PEM_FILE=

# ── Scope ledger listener (scope.v1.ScopeLedgerService) ───────────────────────
# The service-facing money surface, on its own port and mTLS only. Unset ⇒ off. Once
# SCOPE_LEDGER_BIND is set every file below is required and checked at boot; the grants
# file's shape is documented on `ScopeLedgerSettings` (src/config.rs). 50053 is the signer
# sidecar's, so the scope ledger takes 50054.
# SCOPE_LEDGER_BIND=0.0.0.0:50054
# SCOPE_LEDGER_TLS_CERT_PEM_FILE=
# SCOPE_LEDGER_TLS_KEY_PEM_FILE=
# SCOPE_LEDGER_TLS_CLIENT_CA_PEM_FILE=
# SCOPE_LEDGER_GRANTS_FILE=

# ── Auth service (token issuance) ─────────────────────────────────────────────
# All optional: with no signing key the auth service runs inert (mints/authorizes
# nothing), so the hub still boots locally. To enable, generate an Ed25519 keypair:
#   openssl genpkey -algorithm ed25519 -out auth_ed25519.pem
# then set the PEM, a kid, and the matching public JWKS (a {"keys":[{OKP…}]} JSON).
AUTH_SIGNING_KEY_PEM=
AUTH_SIGNING_KID=
AUTH_JWKS_JSON=
# Issuer + audiences (defaults shown). Client access tokens carry the client aud;
# service tokens the service aud — distinct, so the two JWT directions stay apart.
# (Refresh tokens are opaque rotated handles, not JWTs, so they have no audience.)
AUTH_ISSUER=https://auth.banking.ev
AUTH_CLIENT_AUDIENCE=banking-core
AUTH_SERVICE_AUDIENCE=banking-services
# Tokens the scope listener (SCOPE_LEDGER_BIND) issues to its mTLS clients carry THIS aud,
# never banking-services: the signer accepts that one. Must differ from the other two.
AUTH_SCOPE_AUDIENCE=banking-scope
# Token TTLs in seconds (defaults: 15 min access, 30 d refresh, 5 min service). The scope
# listener's tokens have their own TTL, 30..=900 (boot fails outside it).
AUTH_SCOPE_TOKEN_TTL_SECS=300
AUTH_ACCESS_TTL_SECS=900
AUTH_REFRESH_TTL_SECS=2592000
AUTH_SERVICE_TTL_SECS=300

# Concierge→banking token-exchange seam. The cabinet BFF presents this shared bearer on
# AuthService.IssueUserToken to mint a money-plane (aud=banking-core) token pair for a user
# already signed in via concierge. The money plane does NO third-party (Google) OAuth — that
# lives wholly in concierge. Must match BANKING_ISSUANCE_TOKEN on the BFF; unset ⇒ IssueUserToken
# fails closed (the BFF then leaves the money pair empty, money routes surface NotConfigured).
BANKING_ISSUANCE_TOKEN=

# Sentry error tracking via ev::error_monitoring (optional — disabled when unset)
SENTRY_DSN=
APP_ENV=development

# PostHog product analytics via ev::analytics (optional — capture is a no-op when
# POSTHOG_KEY is unset). POSTHOG_HOST defaults to https://us.i.posthog.com.
POSTHOG_KEY=
POSTHOG_HOST=

# The signer authenticates callers — attach the hub's service token (typ=service,
# aud=banking-services) to onward calls. Out-of-band until the MintServiceToken RPC lands.
# SERVICE_TOKEN=

# Client TLS for an off-host (`https://`) signer. Pin the signer's CA (else public roots);
# add a client cert/key to present the hub's certificate for mTLS.
# SIGNER_TLS_CA_PEM_FILE=
# SIGNER_TLS_CLIENT_CERT_PEM_FILE=
# SIGNER_TLS_CLIENT_KEY_PEM_FILE=

# ── On-chain rails (real USDT deposit / withdraw / sweep) ─────────────────────
# Each rail is gated on ITS endpoint var being set; leave a rail's var unset and every one
# of its seams (deposit watcher, withdrawal confirmation watcher, custody, sweep) is a no-op,
# so an unconfigured rail never runs — the same no-op-when-unconfigured stance as the bridge.
# Only configured rails are offered to users (a minted address on an unwatched rail would
# strand funds). Defaults target MAINNET USDT; the commented values below are TESTNET bring-up.
#
# BEP20 (BSC). The endpoint MUST support eth_getLogs for the deposit scan; dataseed does not,
# so BSC_LOGS_RPC_URL routes ONLY the scan to one that does. Measured limits are in the
# flake.nix prod-env note — publicnode over drpc, because drpc's rate limit throttles the
# scan (code 15). Unset ⇒ the scan falls back to BSC_RPC_URL, which REJECTS getLogs, so no
# deposit is ever detected; the watcher warns about this at boot.
# BSC_RPC_URL=https://bsc-dataseed.bnbchain.org        # testnet: https://data-seed-prebsc-1-s1.bnbchain.org:8545
# BSC_LOGS_RPC_URL=https://bsc-rpc.publicnode.com
# BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955   # testnet: your test USDT
# BSC_CHAIN_ID=56                                       # testnet: 97
# BSC_DEPOSIT_START_BLOCK=                              # unset ⇒ watch from now
# The hub's own gas-price ceiling for withdrawals (gwei; Polygon: POLYGON_MAX_GAS_PRICE_GWEI,
# default 5000). A node quote above it is retried on the next drain pass instead of reaching
# the signer, whose fee-budget refusal PARKS the withdrawal until a manual unpark. Keep it
# ≤ the signer's SIGNER_MAX_GAS_PRICE_GWEI_{BEP20,POLYGON} (same defaults) or the pre-check
# protects nothing. BSC_GAS_LIMIT / POLYGON_GAS_LIMIT (default 100000) is the per-transfer gas.
# BSC_MAX_GAS_PRICE_GWEI=100
#
# TRC20 (Tron). One TronGrid REST base serves both the money paths and the indexed deposit scan.
# TRON_RPC_URL=https://api.trongrid.io                  # Nile testnet: https://nile.trongrid.io
# TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t # testnet: the Nile faucet USDT
# TRON_API_KEY=                                         # optional; lifts mainnet rate limits
# TRON_DEPOSIT_START_TS=                                # unix ms; unset ⇒ watch from now
#
# TON (jetton USDT). TON_IS_TESTNET defaults from the URL (a `testnet.` host) and MUST agree
# with it — a testnet URL with the flag off is a hard config error (it would tag mainnet
# addresses for a testnet rail).
# TON_API_URL=https://toncenter.com/api/v3             # testnet: https://testnet.toncenter.com/api/v3
# TON_API_KEY=                                          # optional; lifts the anonymous rate limit
# TON_USDT_MASTER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs  # testnet: kQD0GKBM8ZbryVk2aESmzfU6b9b_8era_IkvBSELujFZPsyy
# TON_IS_TESTNET=                                       # testnet: true (defaults from the URL)
# TON_DEPOSIT_START_UTIME=                              # unix seconds; unset ⇒ watch from now
#
# Sweep (consolidate user deposit-address funds into the treasury). It MOVES user funds
# on-chain, so it is opt-in and sequenced: prove deposits+withdrawals and fund each rail's
# treasury + gas station FIRST, then enable its sweep. SWEEP_ENABLED is the global default;
# a per-rail override lets one rail sweep without arming the others.
# SWEEP_ENABLED=false
# BSC_SWEEP_ENABLED=       # each defaults to SWEEP_ENABLED; set true per rail once funded
# TRON_SWEEP_ENABLED=
# TON_SWEEP_ENABLED=
#
# Withdrawal limits and holds (self-service wallet; all optional, defaults shown). The profile is
# picked from the origin the BFF reports: WITHDRAWAL_FIRST_PARTY_ORIGINS (comma list) are
# first-party, anything else is a scope host and gets the tighter host profile. A malformed
# value refuses the boot rather than silently keeping the default.
# WITHDRAWAL_LIMIT_PER_OP_USDT=4000
# WITHDRAWAL_LIMIT_PER_24H_USDT=10000
# WITHDRAWAL_HOST_LIMIT_PER_OP_USDT=1000
# WITHDRAWAL_HOST_LIMIT_PER_24H_USDT=2000
# WITHDRAWAL_MAX_PER_HOUR=6                      # host profile only; 0 = no cap
# WITHDRAWAL_FIRST_PARTY_ORIGINS=https://evinvest.ltd
# WITHDRAWAL_NEW_ADDRESS_HOLD_SECS=21600         # a first-seen destination waits this long; 0 = off
# WITHDRAWAL_CREDENTIAL_COOLOFF_SECS=21600       # no NEW destinations this long after a sign-in change; 0 = off
