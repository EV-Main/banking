{
  "name": "@evbanking/cabinet",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Host shell for the EV banking cabinet. Composes microfrontends (React and Rust/WASM) as custom elements; same-origin /api/* is proxied to the cabinet backend (the Rust BFF in cabinet/backend).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "test": "CABINET_BACKEND_URL=http://localhost:50062 node --test --experimental-strip-types 'shared/**/*.test.ts' 'features/**/*.test.ts' 'views/**/*.test.ts' 'entities/**/*.test.ts' 'mfe/**/*.test.ts'",
    "gen:api": "openapi-ts",
    "build:mfe": "node mfe/build.mjs && tailwindcss -i mfe/account-chip/mfe.css -o public/mfe/account-chip.css --minify",
    "mfe:pins": "node mfe/pins.mjs",
    "predev": "npm run build:mfe",
    "prebuild": "npm run build:mfe",
    "i18n:extract": "evinvest-i18n-extract --root . --exclude public,messages",
    "i18n:slices": "evinvest-i18n-slices --root . --exclude public,messages --config i18n-slices.config.json --out i18n-slices.json",
    "i18n:check": "evinvest-i18n-check --root . --exclude public,messages && evinvest-i18n-slices --root . --exclude public,messages --config i18n-slices.config.json --out i18n-slices.json --check && tsx scripts/i18n-scope-check.mts && tsx scripts/i18n-check.mts"
  },
  "dependencies": {
    "@evinvest/analytics": "^0.4.0",
    "@evinvest/error-monitoring": "^0.1.0",
    "@evinvest/experiments": "^0.4.0",
    "@evinvest/i18n": "^0.10.1",
    "@evinvest/settings": "^0.5.0",
    "@evinvest/types": "^0.4.0",
    "@evinvest/uikit": "^0.29.1",
    "@sentry/nextjs": "^10.58.0",
    "@sentry/node": "^10.58.0",
    "@sentry/react": "^10.58.0",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.453.0",
    "motion": "^12.43.0",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.390.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-qr-code": "^2.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.98.1",
    "@tailwindcss/cli": "^4.1.14",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.1.14",
    "tsx": "4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3"
  }
}
