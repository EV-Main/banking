# Copy to `.env` and adjust. The cabinet BFF orchestrates two gRPC planes and serves the
# browser's `/api/*` over HTTP (the Next.js frontend rewrites `/api/*` here).
# Topology (CABINET_BACKEND_BIND / PIGGYBANK_GRPC_ADDR / BANKING_AUTH_GRPC_ADDR /
# CONCIERGE_GRPC_ADDR) DEFAULTS from flake.nix; anything set here or in the
# environment wins. Normally this file holds secrets and per-machine overrides.

# Shared bearer the BFF presents on banking IssueUserToken (the concierge→banking seam). Must
# match BANKING_ISSUANCE_TOKEN on the banking side. Unset ⇒ no money pair is minted (money
# routes surface NotConfigured); the concierge identity login still works.
BANKING_ISSUANCE_TOKEN=

# ── Auth (verify-only) ────────────────────────────────────────────────────────
# Auth is SHELL-owned: the concierge auth web surface signs users in; this BFF only
# VERIFIES the shared `ev_access` JWT cookie against the concierge JWKS. Issuer/
# audience must match what the concierge plane stamps (defaults mirror its own).
#AUTH_ISSUER=https://auth.concierge.ev
#AUTH_CLIENT_AUDIENCE=concierge
#AUTH_JWKS_GRPC_ENDPOINT=
# Cookie security: `__Host-`+Secure cookies need HTTPS, which http://localhost rejects —
# leave false in local dev, true in production (or unset to infer from APP_ENV).
AUTH_COOKIE_SECURE=false

# Cross-origin MFE bundle origins (scheme://host[:port], space/comma-separated). Mirrors
# the frontend CSP allow-list. Cross-origin entries also require an SRI integrity hash.
# Same-origin (relative) scriptUrls need no entry.
MFE_ALLOWED_ORIGINS=

# ── Governance websocket ──────────────────────────────────────────────────────
# The one browser origin allowed to open /api/owners/consilium/ws (scheme://host[:port]).
# A websocket handshake is exempt from CORS but still carries the ev_access cookie, so
# without this any page could read the live consilium feed as the signed-in owner — this
# is the socket's half of what the CSRF double-submit does for the mutating REST routes.
# Unset ⇒ not enforced, which is right for local dev; production refuses to boot without
# it rather than failing open. The same origin belongs in the frontend CSP `connect-src`.
# The same origin gates the money mutations (move, withdraw, pay, mandates), and there an
# unset value refuses every request: set it to your browser origin to move money locally.
#CABINET_WS_ORIGIN=https://evinvest.ltd

# ── Wallet reads from the scope hosts ─────────────────────────────────────────
# Exact origins (comma-separated) that may read GET /api/wallet, /api/wallet/compartments
# and /api/operations cross-origin with the user's cookies. Empty ⇒ no CORS at all.
# Mutating routes never answer cross-origin, whatever is listed here.
WALLET_CORS_ORIGINS=

# ── Wallet actions in a host page (docs/WALLET-INTENTS.md) ────────────────────
# Hosts (comma-separated, exact) that may run wallet actions through /api/wallet/intents*.
# Empty ⇒ the routes are not mounted. Each must be a host of the in-code matrix
# (cabinet/backend/src/wallet_intents/mod.rs); the list can only switch one on.
WALLET_ACTION_ORIGINS=
# Kinds the hosts may ask for: move, pay, mandate, withdraw. Default: move only.
#WALLET_ACTION_KINDS=move
# The BFF's wallet key (CSRF tokens for the hosts + the seal on stored intents), at least
# 32 bytes: `openssl rand -hex 32`. Required once WALLET_ACTION_ORIGINS names a host.
WALLET_INTENT_KEY=
# The store every replica shares. Optional off production (an in-process store is used, one
# replica only); required in production once a host is switched on. A secret: in production
# it carries the Redis password (redis://default:<password>@host:6379/<db>).
#REDIS_URL=redis://127.0.0.1:6379/2
# Risk-class lines, decimal USDT: a move at or below the first needs no step-up while the
# user's moves through all hosts in 24 h stay at or below the second; an emailed code may
# confirm a pay or move up to the third, and at most the fourth per user per 24 h through
# all hosts; past either, a passkey only.
#WALLET_MOVE_NO_STEPUP_PER_OP_USDT=100
#WALLET_MOVE_NO_STEPUP_24H_USDT=300
#WALLET_EMAIL_STEPUP_CAP_USDT=250
#WALLET_EMAIL_STEPUP_24H_USDT=500

# ── Observability (all optional; each integration no-ops when unset) ──────────
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=
APP_ENV=development
